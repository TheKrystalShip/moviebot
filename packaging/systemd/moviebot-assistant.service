[Unit]
Description=MovieBot assistant: the plugin that helps people find films, to the assistant harness
After=network-online.target moviebot-api.service
Wants=network-online.target

[Service]
Type=simple
User=moviebot
Group=moviebot
WorkingDirectory=/opt/moviebot/assistant
ExecStart=/opt/moviebot/assistant/moviebot-assistant

# Settings come from ~moviebot/.config/moviebot/moviebot.settings.json; the secrets, and any
# setting a host overrides without editing that file, from the environment file. The model and the
# conversations are the assistant harness's: Assistant__HarnessAddress and Assistant__PluginKey name
# it and the key it issued for this plugin, and without them the plugin cannot register.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
