[Unit]
Description=MovieBot hand-off: turns finished downloads into films the player can open
After=network-online.target moviebot-api.service
Wants=network-online.target

[Service]
Type=simple
User=moviebot
Group=moviebot
WorkingDirectory=/opt/moviebot/handoff
ExecStart=/opt/moviebot/handoff/moviebot-handoff

# Settings come from ~moviebot/.config/moviebot/moviebot.settings.json; the secrets, and any
# setting a host overrides without editing that file, from the environment file.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# The library is the one place it writes, so this names Handoff.MediaRoot from the settings file
# and changes with it. Downloads are only read: qBittorrent removes them.
ReadWritePaths=/srv/moviebot/media
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Transcoding runs on the NVIDIA GPU, so its device nodes stay visible to the service.
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-modeset rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/dri rw

[Install]
WantedBy=multi-user.target
