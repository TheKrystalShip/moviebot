[Unit]
Description=MovieBot API: the library, the media and each room's shared timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moviebot
Group=moviebot
WorkingDirectory=/opt/moviebot/api
ExecStart=/opt/moviebot/api/moviebot-api

# Everything that differs between installations lives in this file.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=Media__Root=/srv/moviebot/media
Environment=Subtitles__Root=/var/lib/moviebot/subtitles
Environment=ASPNETCORE_URLS=http://127.0.0.1:8099
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# The API only reads the library. What it writes (open rooms, downloaded subtitles) goes to
# /var/lib/moviebot, which systemd creates for it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=moviebot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
