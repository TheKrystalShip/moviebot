[Unit]
Description=MovieBot API: the library, the media and each room's shared timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moviebot
Group=moviebot
WorkingDirectory=/opt/moviebot/api
ExecStart=/opt/moviebot/api/moviebot-api

# Settings come from ~moviebot/.config/moviebot/moviebot.settings.json; the secrets, and any
# setting a host overrides without editing that file, from the environment file.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# The API only reads the library. What it writes (open rooms, downloaded subtitles) goes to
# /var/lib/moviebot, which systemd creates for it.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=moviebot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
