# MovieBot configuration, read by all three services.
#
# Installed as /etc/moviebot/moviebot.env. Fill in every value marked REQUIRED, then restart the
# services. This file holds secrets: keep it readable by root and the moviebot group only.
#
# Format: one KEY=value per line, no spaces around '=', no quotes.

# ---------------------------------------------------------------------------------------------
# Discord application (https://discord.com/developers/applications)
# ---------------------------------------------------------------------------------------------

# REQUIRED. Bot page -> Reset Token.
MOVIEBOT_TOKEN=

# REQUIRED. General Information -> Application ID. The same number goes in both lines.
MOVIEBOT_CLIENTID=
Discord__ClientId=

# REQUIRED. OAuth2 page -> Client Secret -> Reset Secret.
Discord__ClientSecret=

# REQUIRED. The ID of your Discord server. In Discord, turn on Settings -> Advanced ->
# Developer Mode, then right-click the server icon -> Copy Server ID.
Discord__GuildIds__0=

# ---------------------------------------------------------------------------------------------
# Public address
# ---------------------------------------------------------------------------------------------

# REQUIRED. The https address this machine is reachable at, with no trailing slash.
# Both lines carry the same value, for example https://movies.example.com
Player__BaseUrl=
Api__PublicBaseUrl=

# ---------------------------------------------------------------------------------------------
# Internal keys
# ---------------------------------------------------------------------------------------------

# Generated by install.sh. Leave them as they are.
# Auth__SigningKey signs the tokens viewers get after signing in with Discord.
# Auth__ServiceKey and Api__ServiceKey are one shared key the bot and the hand-off use to talk to
# the API; the two lines must stay identical.
Auth__SigningKey=
Auth__ServiceKey=
Api__ServiceKey=

# ---------------------------------------------------------------------------------------------
# Tracker
# ---------------------------------------------------------------------------------------------

# REQUIRED. Your tracker account. The tracker must offer a member API that accepts a username
# and passkey.
Tracker__BaseUrl=
Tracker__Username=
Tracker__Passkey=

# REQUIRED. The tracker's category names that films may be downloaded from, spelled exactly as
# the tracker spells them. Add more lines with __1, __2 and so on.
Selection__AllowedCategories__0=

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------

# An OpenSubtitles API key (https://www.opensubtitles.com/consumers), so viewers can fetch
# subtitles a film does not carry. Leave empty to turn this off.
OpenSubtitles__ApiKey=
