# MovieBot secrets, read by all three services.
#
# Installed as /etc/moviebot/moviebot.env, readable only by root and the moviebot group. Settings
# that are not secret live in /srv/moviebot/.config/moviebot/moviebot.settings.json.
#
# Fill in every value marked REQUIRED, then restart the services.
# Format: one KEY=value per line, no spaces around '=', no quotes.
#
# Any setting from moviebot.settings.json can also be overridden here, written as Section__Key:
# for example Download__MaximumGiB=500.

# ---------------------------------------------------------------------------------------------
# Discord application (https://discord.com/developers/applications)
# ---------------------------------------------------------------------------------------------

# REQUIRED. Bot page -> Reset Token.
MOVIEBOT_TOKEN=

# REQUIRED. OAuth2 page -> Client Secret -> Reset Secret.
Discord__ClientSecret=

# ---------------------------------------------------------------------------------------------
# Internal keys
# ---------------------------------------------------------------------------------------------

# Generated by install.sh. Leave them as they are.
# Auth__SigningKey signs the tokens viewers get after signing in with Discord; the assistant checks
# those tokens with it too.
# Auth__ServiceKey and Api__ServiceKey are one shared key the bot, the hand-off and the assistant use
# to talk to the API and to each other; the two lines must stay identical.
Auth__SigningKey=
Auth__ServiceKey=
Api__ServiceKey=

# ---------------------------------------------------------------------------------------------
# Tracker
# ---------------------------------------------------------------------------------------------

# REQUIRED. Your tracker account. The tracker must offer a member API that accepts a username
# and passkey.
Tracker__BaseUrl=
Tracker__Username=
Tracker__Passkey=

# REQUIRED. The tracker's category names that films may be downloaded from, spelled exactly as
# the tracker spells them. Add more lines with __1, __2 and so on. An empty line here stops the
# services from starting.
Selection__AllowedCategories__0=

# ---------------------------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------------------------

# The tracker's category names that shows may be downloaded from, spelled exactly as the tracker
# spells them, with __1, __2 and so on for more. Without any, no show is offered.
Selection__AllowedShowCategories__0=

# An OpenSubtitles API key (https://www.opensubtitles.com/consumers), so viewers can fetch
# subtitles a film does not carry. Leave empty to turn this off.
OpenSubtitles__ApiKey=

# A TMDB "API Read Access Token" (https://www.themoviedb.org/settings/api), so the site shows each
# film's rating, credits, certificate, genres, overview and artwork. TMDB is free for personal use
# and asks to be credited, which the site does on every page. Leave empty to describe films by name,
# year and poster alone.
Tmdb__ReadAccessToken=
