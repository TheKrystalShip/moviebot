<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <RootNamespace>TheKrystalShip.MovieBot.Tests</RootNamespace>
    <AssemblyName>MovieBot.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.11" />
  </ItemGroup>

  <!-- The advisory on the native SQLite the bot's conversation store pulls in; see MovieBot.Bot.csproj. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <!-- Rooms' real conversations, replayed against the live model before a routing failure seen live counts as fixed. -->
  <ItemGroup>
    <None Include="Replays/*.jsonl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The bot's shipped settings, under a name of their own: every referenced service copies an
       appsettings.json into this output directory, and which one lands last depends on build order. -->
  <ItemGroup>
    <None Include="../../src/MovieBot.Bot/appsettings.json" Link="bot.appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/MovieBot.Api/MovieBot.Api.csproj" />
    <ProjectReference Include="../../src/MovieBot.Bot/MovieBot.Bot.csproj" />
    <ProjectReference Include="../../src/MovieBot.Handoff/MovieBot.Handoff.csproj" />
    <ProjectReference Include="../../src/MovieBot.Ingest/MovieBot.Ingest.csproj" />
  </ItemGroup>

</Project>
