// Behavioural cases for the MovieBot assistant plugin, written as data. Each case is one conversation
// with a person who may watch (cinema:watch), run against the live harness through the plugin's POST
// /turn. A runner reads the file, plays each turn's `say` (or `answers`, to a question the previous turn
// asked) and checks the frames the turn produced.
//
//   id, group, title    naming the case and what it exercises
//   turns[]             {say} or {answers: [{header?, question?, labels, text?}]}, each with an optional `expect`
//   expect              what must hold; on the case it spans the conversation (calls over every turn, text of the last)
//     calls             [{tool, args?, min?}]  tools that must be called; args is a subset, "~..." is a regular expression
//     notCalled         tools that must not be called
//     asks / noQuestion the turn must end on a question frame / must not
//     cards             kinds of card the tool results must carry
//     match / notMatch  regular expressions the reply must / must not match (case-insensitive)
//     maxCalls          at most this many tool calls
//     staged / noProposal  proposals that must be made (each {tool, args?}) / that none is made
{
  "cases": [
    {
      "id": "search-by-title",
      "group": "search_titles",
      "title": "A title named outright is searched for",
      "turns": [ { "say": "Do you have the film Inception?" } ],
      "expect": {
        "calls": [ { "tool": "search_titles", "args": { "query": "~inception" } } ],
        "cards": [ "titles" ],
        "match": [ "Inception", "2010" ],
        "noQuestion": true
      }
    },
    {
      "id": "filmography-exact-years",
      "group": "person_credits",
      "title": "A filmography is listed with the database's years",
      "turns": [ { "say": "List Anne Hathaway's films from the 2010s with their years." } ],
      "expect": {
        "calls": [ { "tool": "person_credits", "args": { "person": "~hathaway" } } ],
        "cards": [ "titles" ],
        "match": [ "Interstellar", "2014", "Les Mis" ],
        "notMatch": [ "\\((19[0-9]{2}|200[0-9])\\)" ],
        "noQuestion": true
      }
    },
    {
      "id": "clues-soft",
      "group": "find_by_clues",
      "title": "A half-remembered film is found from soft clues, and more clues are invited",
      "turns": [
        { "say": "There's a movie with Robert Pattinson where two men slowly go mad somewhere remote, and I can't remember the name of it." }
      ],
      "expect": {
        "calls": [ { "tool": "find_by_clues" } ],
        "match": [ "The Lighthouse", "2019", "(let me know|tell me|any other|any more|anything else|more (detail|clue))" ],
        "noQuestion": true
      }
    },
    {
      "id": "clues-follow-up",
      "group": "find_by_clues",
      "title": "A second clue narrows the same film",
      "turns": [
        { "say": "There's a movie with Robert Pattinson where two men slowly go mad somewhere remote, and I can't remember the name of it." },
        { "say": "It was set on an island and Willem Dafoe was in it too." }
      ],
      "expect": {
        "calls": [ { "tool": "find_by_clues", "min": 1 } ],
        "match": [ "The Lighthouse", "2019" ],
        "noQuestion": true
      }
    },
    {
      "id": "discover-early-2000s-horror",
      "group": "discover",
      "title": "A request by genre and era is answered from discover",
      "turns": [ { "say": "Can you suggest an early-2000s horror film?" } ],
      "expect": {
        "calls": [ { "tool": "discover" } ],
        "cards": [ "titles" ],
        "match": [ "\\(200[0-5]\\)" ],
        "noQuestion": true
      }
    },
    {
      "id": "discover-really-good-horror-after-2000",
      "group": "discover",
      "title": "A request for really good horror after 2000 leads with well-known horror, not children's titles or barely voted ones",
      "turns": [ { "say": "Can you suggest really good horror movies from after 2000?" } ],
      "expect": {
        "calls": [ { "tool": "discover", "args": { "genre": "~horror" } } ],
        "cards": [ "titles" ],
        "match": [ "\\((200[1-9]|20[1-2][0-9])\\)" ],
        "notMatch": [ "Succubus", "Chaneques", "Scooby" ],
        "noQuestion": true
      }
    },
    {
      "id": "whats-new",
      "group": "whats_new",
      "title": "What arrived recently",
      "turns": [ { "say": "What's new?" } ],
      "expect": {
        "calls": [ { "tool": "whats_new" } ],
        "noQuestion": true
      }
    },
    {
      "id": "taste-survey-asks",
      "group": "ask_question",
      "title": "A request to learn the person's taste is asked as a question frame",
      "turns": [ { "say": "Ask me a few questions about what I like so you can recommend something for tonight." } ],
      "expect": {
        "asks": true
      }
    },
    {
      "id": "nonexistent-film",
      "group": "search_titles",
      "title": "A film that does not exist is reported as not found, without an invented title",
      "turns": [ { "say": "Do you have a film called The Zorblax Conspiracy of Venn?" } ],
      "expect": {
        "calls": [ { "tool": "search_titles" } ],
        "match": [ "(could not|couldn't|can't|cannot|did not|didn't|no ).{0,40}(find|match|result|see)|not find|isn't|is not" ],
        "notMatch": [ "Zorblax Conspiracy of Venn \\(\\d{4}\\)" ],
        "noQuestion": true
      }
    },
    {
      "id": "character-to-actress-to-film",
      "group": "person_credits",
      "title": "A character is traced to the actress with a search and then to the film",
      "turns": [
        { "say": "The actress that played Amy Pond in Doctor Who also plays in a horror movie with a mirror. Can you tell me the name of said movie?" }
      ],
      "expect": {
        "calls": [ { "tool": "web_search" } ],
        "match": [ "Oculus" ],
        "notMatch": [ "Billie Piper" ],
        "maxCalls": 4,
        "noQuestion": true
      }
    },
    {
      "id": "want-proposed",
      "group": "want",
      "title": "Wanting a title is proposed, and the reply says it waits on the person",
      "turns": [ { "say": "Put Inception on my want to watch list." } ],
      "expect": {
        "staged": [ { "tool": "want" } ],
        "notMatch": [ "\\bI(?:'ve| have) added\\b", "\\bis now on your\\b" ],
        "noQuestion": true
      }
    },
    {
      "id": "want-after-details",
      "group": "want",
      "title": "A title read with title_details is then wanted, and the want carries it",
      "turns": [
        { "say": "Do you have Hidden Figures?" },
        { "say": "Tell me more about it, who directed it and how long is it?" },
        { "say": "Sounds good. Could you add it to my want to watch list?" }
      ],
      "expect": {
        "calls": [ { "tool": "title_details" } ],
        "staged": [ { "tool": "want", "args": { "title": "~hidden figures|tt4846340" } } ],
        "notMatch": [ "\\bI(?:'ve| have) added\\b", "\\bis now on your\\b", "error" ]
      }
    },
    {
      "id": "want-two-found",
      "group": "want",
      "title": "Two titles found earlier in the conversation are wanted in one proposal",
      "turns": [
        { "say": "Tell me about Inception." },
        { "say": "And what about Heat, the one with Al Pacino?" },
        { "say": "Could you add both of those to my want to watch list?" }
      ],
      "expect": {
        "staged": [ { "tool": "want", "args": { "title": "~(?s)(inception|tt1375666).*(heat|tt0113277)|(heat|tt0113277).*(inception|tt1375666)" } } ],
        "notMatch": [ "\\bI(?:'ve| have) added\\b", "\\bis now on your\\b", "error" ]
      }
    },
    {
      "id": "recommend-proposes-nothing-unasked",
      "group": "want",
      "title": "A recommendation offers to want titles and proposes nothing",
      "turns": [ { "say": "Recommend me two or three good horror films from the early 2000s." } ],
      "expect": {
        "calls": [ { "tool": "discover" } ],
        "noProposal": true
      }
    },
    {
      "id": "wanted-together",
      "group": "wanted_together",
      "title": "What the person wants with others is read, and nothing is proposed",
      "turns": [ { "say": "Is there anything on my want to watch list that somebody else wants to watch too?" } ],
      "expect": {
        "calls": [ { "tool": "wanted_together" } ],
        "noProposal": true
      }
    },
    {
      "id": "plans-read",
      "group": "my_plans",
      "title": "The person's plans are read, and nothing is proposed",
      "turns": [ { "say": "Do I have any movie nights planned?" } ],
      "expect": {
        "calls": [ { "tool": "my_plans" } ],
        "noProposal": true
      }
    },
    {
      "id": "plan-asks-who",
      "group": "make_plan",
      "title": "A watch party with nobody named asks who before proposing",
      "turns": [ { "say": "Set up a watch party for Inception." } ],
      "expect": {
        "noProposal": true,
        "match": [ "\\?" ]
      }
    },
    {
      "id": "plan-proposed",
      "group": "make_plan",
      "title": "A plan with a title and a time is proposed at that time in the person's clock",
      "turns": [ { "say": "Make a plan to watch Inception next Saturday at 21:00. Just me for now, I'll invite people later." } ],
      "expect": {
        "staged": [ { "tool": "make_plan", "args": { "title": "~inception|tt1375666" } } ],
        "notMatch": [ "\\bplan is made\\b", "\\bI(?:'ve| have) (?:made|created|set up)\\b" ]
      }
    }
  ]
}
