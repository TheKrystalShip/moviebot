{
  "name": "krystal-cinema",
  "private": true,
  "version": "0.63.0",
  "type": "module",
  "description": "Krystal Cinema: MovieBot's site, served by MovieBot.Api.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src verify scripts public/sw.js",
    "check": "tsc -p .",
    "test": "node --test verify/heads.test.mjs verify/remote.test.mjs verify/devicePlaylist.test.mjs",
    "verify": "node verify/run.mjs",
    "verify:routes": "node verify/routes.mjs",
    "verify:mobile": "node verify/mobile/run.mjs",
    "verify:pwa": "node verify/pwa.mjs",
    "verify:tv": "node verify/tv.mjs",
    "verify:offline": "node verify/saving.mjs && node verify/growing.mjs && node verify/offline.mjs",
    "verify:device": "node verify/device.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@microsoft/signalr": "^8.0.29",
    "@thekrystalship/krystal-ui": "0.24.0",
    "hls.js": "^1.7.3",
    "lean-qr": "^2.7.4",
    "lucide-react": "^0.460.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.5"
  }
}
