{
  "name": "krystal-cinema",
  "private": true,
  "version": "0.90.0",
  "type": "module",
  "description": "Krystal Cinema: MovieBot's site, served by MovieBot.Api.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint src verify scripts public/sw.js",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check": "tsc -p .",
    "test": "node --test verify/heads.test.mjs verify/remote.test.mjs verify/devicePlaylist.test.mjs verify/revision.test.mjs verify/tracks.test.mjs verify/ordered.test.mjs verify/sessionMigration.test.mjs verify/sessionView.test.mjs verify/activitySession.test.mjs",
    "verify": "node verify/run.mjs",
    "verify:routes": "node verify/routes.mjs",
    "verify:mobile": "node verify/mobile/run.mjs",
    "verify:phone-player": "node verify/mobile/player.mjs",
    "verify:pull": "node verify/mobile/pull.mjs",
    "verify:dock": "node verify/mobile/dock.mjs",
    "verify:pwa": "node verify/pwa.mjs",
    "verify:tv": "node verify/tv.mjs",
    "verify:tv-perf": "node verify/tvperf/run.mjs",
    "verify:stage": "node verify/stage.mjs",
    "verify:tv-sweep": "node verify/tvsweep/sweep.mjs",
    "verify:tv-focus": "node verify/tvfocus/focus.mjs",
    "verify:offline": "node verify/saving.mjs && node verify/growing.mjs && node verify/offline.mjs",
    "verify:device": "node verify/device.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@microsoft/signalr": "^8.0.29",
    "@thekrystalship/auth-client": "0.2.0",
    "@thekrystalship/krystal": "3.0.0",
    "@thekrystalship/krystal-chat": "3.0.0",
    "hls.js": "^1.7.3",
    "lean-qr": "^2.7.4",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "jsqr": "^1.4.0",
    "playwright-core": "^1.63.0",
    "stylelint": "^16.26.1",
    "typescript": "^5.9.3",
    "vite": "^6.0.5"
  }
}
