[Unit]
Description=MovieBot API — library, media and the room's shared timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/api
ExecStart=/opt/moviebot/api/moviebot-api

# Settings come from /home/heisen/.config/moviebot/moviebot.settings.json (deploy/hotbox.settings.json);
# credentials and the tracker's identity from the environment file. systemd does not read
# /etc/environment, so relying on the ambient environment gives a service that starts empty.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# It serves the library and fetches films: it reaches the tracker, the title index and the torrent
# client over the network, and writes nothing outside its own state.
#
# The media root stays read-only. What this writes goes to its own state directory, which systemd
# makes and hands over in the environment: its database (people's records, the rooms, the wish
# list) and subtitles fetched from outside. None belongs under the
# media root — everything there is regenerable from the source file, a
# re-ingest replaces a title's directory wholesale, and the transcode rewrites the manifest inside
# it every few seconds. A subtitle that cost a download, a room somebody is sitting in and a film
# somebody is waiting on are neither regenerable nor replaceable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# The download directory has to be readable, because the disk budget is measured off the
# filesystem. Masked away entirely, the budget reads zero used and the ceiling never stops
# anything — a wrong answer that looks exactly like plenty of room.
ProtectHome=read-only
ReadOnlyPaths=/home/heisen/moviebot/media /home/heisen/moviebot/cold
StateDirectory=moviebot
# The catalogue's directory, which moviebot-catalogue writes: the API reads catalogue.db and serves
# images/, and a reader of a database in WAL mode writes its shared-memory file beside it.
ReadWritePaths=-/var/lib/moviebot-catalogue
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
