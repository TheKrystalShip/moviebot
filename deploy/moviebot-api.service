[Unit]
Description=MovieBot API — library, media and the room's shared timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/api
ExecStart=/opt/moviebot/api/moviebot-api

# Settings come from /home/heisen/.config/moviebot/moviebot.settings.json (deploy/hotbox.settings.json);
# credentials and the tracker's identity from the environment file. systemd does not read
# /etc/environment, so relying on the ambient environment gives a service that starts empty.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# It serves files it is given and talks to nobody but nginx, the media root and its own state.
#
# The media root stays read-only. What this writes goes to its own state directory, which systemd
# makes and hands over in the environment: subtitles fetched from outside, and the rooms. Neither
# belongs under the media root — everything there is regenerable from the source file, a re-ingest
# replaces a title's directory wholesale, and the transcode rewrites the manifest inside it every
# few seconds. A subtitle that cost a download and a room somebody is sitting in are neither
# regenerable nor replaceable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/heisen/moviebot/media /home/heisen/moviebot/cold
StateDirectory=moviebot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
