[Unit]
Description=MovieBot API — library, media and the room's shared timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/api
ExecStart=/opt/moviebot/api/moviebot-api

# Credentials and configuration. systemd does not read /etc/environment, so anything the service
# needs is named here or in the file below; relying on the ambient environment gives a service
# that starts empty and fails as though the network were down.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=Media__Root=/home/heisen/moviebot/media
Environment=Subtitles__Root=/var/lib/moviebot/subtitles
Environment=ASPNETCORE_URLS=http://127.0.0.1:8099
# Where Discord's own servers reach this API. The Activity builds poster URLs for a viewer's
# presence from it, because its own origin is Discord's proxy and reachable from nowhere else.
Environment=Api__PublicBaseUrl=https://movies.thekrystalship.com
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# It serves files it is given and talks to nobody but nginx, the media root and its own state.
#
# The media root stays read-only. What this writes goes to its own state directory, which systemd
# makes and hands over in the environment: subtitles fetched from outside, and the rooms. Neither
# belongs under the media root — everything there is regenerable from the source file, a re-ingest
# replaces a title's directory wholesale, and the transcode rewrites the manifest inside it every
# few seconds. A subtitle that cost a download and a room somebody is sitting in are neither
# regenerable nor replaceable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/heisen/moviebot/media
StateDirectory=moviebot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
