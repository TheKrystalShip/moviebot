[Unit]
Description=MovieBot API — library, media and the room's shared timeline
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/api
ExecStart=/opt/moviebot/api/moviebot-api

# Credentials and configuration. systemd does not read /etc/environment, so anything the service
# needs is named here or in the file below; relying on the ambient environment gives a service
# that starts empty and fails as though the network were down.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=Media__Root=/home/heisen/tks/moviebot/media
Environment=Subtitles__Root=/var/lib/moviebot/subtitles
Environment=ASPNETCORE_URLS=http://127.0.0.1:8099
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# It serves files it is given and talks to nobody but nginx, the media root and its own state.
#
# The media root stays read-only. Subtitles fetched from outside are the one thing this writes,
# and they go to their own directory: everything under the media root is regenerable from the
# source file, a re-ingest replaces a title's directory wholesale, and the transcode rewrites the
# manifest inside it every few seconds. None of that is true of a subtitle that cost a download.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/heisen/tks/moviebot/media
StateDirectory=moviebot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
