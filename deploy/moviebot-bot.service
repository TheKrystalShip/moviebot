[Unit]
Description=MovieBot Discord bot
After=network-online.target moviebot-api.service
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/bot
ExecStart=/opt/moviebot/bot/moviebot-bot

EnvironmentFile=/etc/moviebot/moviebot.env
Environment=Discord__GuildIds__0=385730677141929985
# Named rather than left to resolve from the environment. A service inherits none of a desktop
# session's variables, so a fallback that reads them agrees with the torrent client only for as
# long as both happen to be launched the same way.
Environment=Download__Root=/home/heisen/Downloads/Movies
Environment=Api__BaseUrl=http://127.0.0.1:8099
Environment=Api__PublicBaseUrl=https://movies.thekrystalship.com
Environment=Player__BaseUrl=https://movies.thekrystalship.com
Environment=QBittorrent__BaseUrl=http://127.0.0.1:8081
Environment=DOTNET_EnableDiagnostics=0

# A dropped gateway connection is normal; the bot reconnects, and a crash should not need a person.
Restart=always
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# The films people are waiting on are the one thing the bot writes down, and this is the only
# place it may write. systemd makes the directory and names it in STATE_DIRECTORY.
StateDirectory=moviebot-bot

# The download directory has to be readable, because the disk budget is measured off the
# filesystem. Masked away entirely, the budget reads zero used and the ceiling never stops
# anything — a wrong answer that looks exactly like plenty of room.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
