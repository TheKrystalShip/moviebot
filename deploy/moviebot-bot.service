[Unit]
Description=MovieBot Discord bot
After=network-online.target moviebot-api.service
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/bot
ExecStart=/opt/moviebot/bot/moviebot-bot

# Settings come from /home/heisen/.config/moviebot/moviebot.settings.json (deploy/hotbox.settings.json);
# credentials and the tracker's identity from the environment file. systemd does not read
# /etc/environment, so relying on the ambient environment gives a service that starts empty.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

# Listening in a voice channel reaches moviebot-speech over its socket; libdave, opus and libsodium
# are what a voice connection needs from the system. The assistant's conversation and the model's
# warm-up request are written in the state directory below.

# A dropped gateway connection is normal; the bot reconnects, and a crash should not need a person.
Restart=always
RestartSec=10s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# The films people are waiting on are the one thing the bot writes down, and this is the only
# place it may write. systemd makes the directory and names it in STATE_DIRECTORY.
StateDirectory=moviebot-bot

# The download directory has to be readable, because the disk budget is measured off the
# filesystem. Masked away entirely, the budget reads zero used and the ceiling never stops
# anything — a wrong answer that looks exactly like plenty of room.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
