[Unit]
Description=MovieBot assistant — what people say to MovieBot, answered with the language model
After=network-online.target moviebot-api.service moviebot-llm.service
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/assistant
ExecStart=/opt/moviebot/assistant/moviebot-assistant

# Settings come from /home/heisen/.config/moviebot/moviebot.settings.json (deploy/hotbox.settings.json),
# among them the identity provider whose tokens it takes (Oidc:Issuer); it holds no key of its own and
# reaches the API with each person's token. The environment file is read for whatever a host sets
# there. systemd does not read /etc/environment, so relying on the ambient environment gives a service
# that starts empty.
EnvironmentFile=/etc/moviebot/moviebot.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# It talks to the API, the model and the title index, and writes nothing outside its own state:
# the conversations, and the request that warms the model, which moviebot-llm replays on start.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
StateDirectory=moviebot-assistant

# The settings file is read from the account's XDG configuration directory.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
