[Unit]
Description=MovieBot assistant — the plugin that helps people find films, to the assistant harness
After=network-online.target moviebot-api.service
Wants=network-online.target

[Service]
Type=simple
User=heisen
Group=heisen
WorkingDirectory=/opt/moviebot/assistant
ExecStart=/opt/moviebot/assistant/moviebot-assistant

# Settings come from /home/heisen/.config/moviebot/moviebot.settings.json (deploy/hotbox.settings.json),
# among them the identity provider whose tokens it takes (Oidc:Issuer); it mints no token and reaches
# the API with each person's token. assistant.env holds where the harness is and the key it issued
# for this plugin; moviebot.env is read for whatever a host sets there. systemd does not read
# /etc/environment, so relying on the ambient environment gives a service that starts empty.
EnvironmentFile=/etc/moviebot/moviebot.env
EnvironmentFile=/etc/moviebot/assistant.env
Environment=DOTNET_EnableDiagnostics=0

Restart=on-failure
RestartSec=5s

# It talks to the API, the harness and the identity provider, and writes nothing.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

# The settings file is read from the account's XDG configuration directory.
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
