<?xml version="1.0" encoding="utf-8"?>
<!-- Krystal Cinema on a phone. The version is the build's (phone/build.sh, from phone/CHANGELOG.md),
     set on the command line rather than here. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thekrystalship.cinema.phone">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- The download service: a foreground service of the data transfer kind, its notification, and the
       locks that keep the CPU and the Wi-Fi radio awake while bytes are moving. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <application
      android:label="@string/app_name"
      android:icon="@mipmap/icon"
      android:allowBackup="false"
      android:networkSecurityConfig="@xml/network_security_config"
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
    <activity android:name=".CinemaActivity" android:exported="true"
        android:launchMode="singleTask"
        android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <service android:name=".DownloadService" android:exported="false"
        android:foregroundServiceType="dataSync" />
  </application>
</manifest>
