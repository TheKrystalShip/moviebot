<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.MovieBot.Bot</RootNamespace>
    <AssemblyName>moviebot-bot</AssemblyName>
    <Version>0.15.1</Version>

    <!-- The JIT is where this process's memory goes, not the heap, and a method compiled once at
         full optimisation is held once. Startup time is nothing to a worker that runs for weeks,
         so there is no tiering to grow the code heap and no PGO to keep copies of hot methods. -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>

    <!-- The token is supplied by the environment in production and by user-secrets in
         development. Nothing about it is ever written into the repository. -->
    <UserSecretsId>moviebot-bot</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The console SDK copies no content by default, and the host reads its settings from the
         directory it runs in. -->
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The assistant's instructions and tool descriptions, read from beside the binary. -->
    <Content Include="prompts/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />

    <!-- Listening in a voice channel: utterances, the wake word, the silence that ends a sentence.
         The package belongs to no product, and this bot supplies what only it can answer — where
         the recogniser is, and what a spoken request does to a room. It resolves libdave by name at
         runtime for the encryption every voice call requires. -->
    <PackageReference Include="TheKrystalShip.Discord.Voice" Version="1.4.0" />

    <!-- The client and wire contract for moviebot-speech's socket, and the rules about which parts
         of a transcript are speech. A few kilobytes and no native code: the model is in the other
         process. -->
    <PackageReference Include="TheKrystalShip.Speech" Version="1.1.0" />

    <!-- The agent loop and its conversation store, for what somebody says that the room verbs do not
         cover. The model is moviebot-llm, reached over loopback; nothing of it runs in this process. -->
    <PackageReference Include="TheKrystalShip.Llm" Version="2.4.0" />

    <!-- What an assistant needs around the loop and belongs to no product: the prompt directory, the
         catalog file and its agreement check, the checks a reply is held to, compaction, and the
         single-use handle a proposal is redeemed by. -->
    <PackageReference Include="TheKrystalShip.Agent" Version="1.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <!-- GHSA-2m69-gcr7-jv3q is on the native SQLite the conversation store pulls in, and no build of it
       fixes the advisory. The database is this bot's own conversation, reached by no SQL anybody else
       writes and no network. Scoped to that advisory alone. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MovieBot.Core/MovieBot.Core.csproj" />

    <!-- The acquiring half of the pipeline, from the repository beside this one. It is a library
         and reflection-free, so referencing it costs this project nothing it did not already
         have. -->
    <ProjectReference Include="../../../moviebot-acquire/src/MovieBot.Acquire/MovieBot.Acquire.csproj" />
  </ItemGroup>

</Project>
