<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.MovieBot.Bot</RootNamespace>
    <AssemblyName>moviebot-bot</AssemblyName>
    <Version>2.0.0</Version>

    <!-- The JIT is where this process's memory goes, not the heap, and a method compiled once at
         full optimisation is held once. Startup time is nothing to a worker that runs for weeks,
         so there is no tiering to grow the code heap and no PGO to keep copies of hot methods. -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>

    <!-- The token is supplied by the environment in production and by user-secrets in
         development. Nothing about it is ever written into the repository. -->
    <UserSecretsId>moviebot-bot</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared settings file, shipped beside the binary as the defaults. -->
    <Content Include="../moviebot.settings.json" Link="moviebot.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Discord.Net" Version="3.20.1" />

    <!-- Discord.Net's libdave binding, built by tks-assistant's packaging/discord-net-dave with user ids
         NUL-terminated. The release passes them unterminated, and libdave then reads some speakers'
         ids as users who do not exist and cannot decrypt a word they say. -->
    <PackageReference Include="Discord.Net.Dave" Version="3.20.2-tks.1" />

    <!-- Listening in a voice channel: utterances, the wake word, the silence that ends a sentence.
         The package belongs to no product, and this bot supplies what only it can answer — where
         the recogniser is, and what a spoken request does to a room. It resolves libdave by name at
         runtime for the encryption every voice call requires. -->
    <PackageReference Include="TheKrystalShip.Discord.Voice" Version="3.0.0" />

    <!-- The client and wire contract for moviebot-speech's socket, and the rules about which parts
         of a transcript are speech. A few kilobytes and no native code: the model is in the other
         process. -->
    <PackageReference Include="TheKrystalShip.Speech" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The API client is read everywhere in the bot, so its namespace is imported once. -->
    <Using Include="TheKrystalShip.MovieBot.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MovieBot.Core/MovieBot.Core.csproj" />

    <!-- The API client, and the wire moviebot-assistant speaks: the bot reaches both through it, and
         builds without the assistant's own project. -->
    <ProjectReference Include="../MovieBot.Client/MovieBot.Client.csproj" />

    <!-- The acquiring half of the pipeline, from the repository beside this one. It is a library
         and reflection-free, so referencing it costs this project nothing it did not already
         have. -->
    <ProjectReference Include="../../../moviebot-acquire/src/MovieBot.Acquire/MovieBot.Acquire.csproj" />
  </ItemGroup>

</Project>
