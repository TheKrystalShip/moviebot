// MovieBot settings, read by every MovieBot service.
//
// A copy of this file ships beside each program and holds the defaults. The copy a host edits is
// $XDG_CONFIG_HOME/moviebot/moviebot.settings.json of the account the services run as (by default
// ~/.config/moviebot/), or /etc/xdg/moviebot/moviebot.settings.json. The environment overrides any
// single key, as Section__Key, and it is where secrets go: tokens, keys and the tracker account.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  // The Discord application. ApplicationId is the number on its General Information page, and
  // GuildIds the servers the bot answers in, each written as a string: ["123456789012345678"].
  "Discord": {
    "ApplicationId": null,
    "GuildIds": []
  },

  // The OpenID Connect provider people sign in with; MovieBot signs nobody in. Issuer is the
  // provider's issuer, exactly as its tokens carry it, and has no default: the API records it the first
  // time it starts and refuses another until AdoptIssuer names it (an empty IssuerRecord is the file
  // `issuer` in the state directory). Access tokens are taken for Audience alone and list a person's
  // Cinema actions in ActionsClaim. The site signs in as the public client SiteClientId, and on a
  // television as the public device client TvClientId; the API
  // exchanges the Activity's Discord token as ActivityClientId and the bot a Discord user as
  // BotClientId, each a confidential client whose secret is set only in the environment, as
  // Oidc__ActivityClientSecret and Oidc__BotClientSecret.
  "Oidc": {
    "Issuer": "",
    "Audience": "cinema",
    "ActionsClaim": "tks_actions",
    "SiteClientId": "cinema-site",
    "TvClientId": "cinema-tv",
    "ActivityClientId": "cinema-activity",
    "BotClientId": "cinema-bot",
    "AdoptIssuer": "",
    "IssuerRecord": ""
  },

  // The television app built for this site (tv/), served at /tv.apk. App is its path; empty is
  // tv.apk in the state directory. Without the file, /tv.apk answers 404.
  "Tv": {
    "App": ""
  },

  // Where people reach this host: the https address the Activity is mapped to.
  "Player": {
    "BaseUrl": ""
  },

  // How the bot and the hand-off reach the API, and where Discord's own servers reach it.
  "Api": {
    "BaseUrl": "http://127.0.0.1:8099",
    "PublicBaseUrl": ""
  },

  // The API's own address. nginx forwards to it; nothing else should.
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:8099" }
    }
  },

  // The library the API serves. ColdRoot, when set, is a second disk finished films move to.
  "Media": {
    "Root": "/srv/moviebot/media",
    "ColdRoot": ""
  },

  "Subtitles": {
    "Root": "/var/lib/moviebot/subtitles"
  },

  "Rooms": {
    "IdleTimeout": "00:30:00",
    "SweepInterval": "00:01:00"
  },

  // The hand-off writes films into MediaRoot, which must be the API's Media.Root. Films share the
  // GPU, so each of MaxConcurrentIngests runs slower than one alone.
  "Handoff": {
    "MediaRoot": "/srv/moviebot/media",
    "ColdRoot": "",
    "PollSeconds": 30,
    "MinimumFilmSizeMiB": 200,
    "StartAtProgress": 0.05,
    "MaxConcurrentIngests": 2
  },

  // Where qBittorrent saves downloads, and how much of the disk they may take. ReservedGiB stays
  // free on that volume once a download lands, for the transcode of the film it admits, which
  // holds no claim of its own until its ingest starts; 0 when nothing else writes there. The
  // claims of transcodes already running are subtracted on top of it, as measured.
  "Download": {
    "Root": "/srv/moviebot/downloads",
    "MaximumGiB": 300,
    "WarningGiB": 250,
    "ReservedGiB": 30
  },

  "QBittorrent": {
    "BaseUrl": "http://127.0.0.1:8080",
    "Category": "moviebot",
    "SequentialDownload": true,
    "FirstLastPiecePriority": true
  },

  // Which releases are offered. The tracker's category names are set in the environment, beside
  // the tracker account, as Selection__AllowedCategories__0, __1 and so on.
  "Selection": {
    "MaximumResolution": "Hd1080",
    "PreferredResolution": "Hd1080",
    "MaximumSizeGiB": 25,
    "MaximumResults": 10,
    "TierByTrackerFlags": true
  },

  // How long a downloaded film keeps seeding before its torrent and downloaded files are removed.
  "Retention": {
    "SeedDays": 7,
    "TrackerMinimumHours": 48,
    "MarginHours": 12
  },

  // How long a film stays in the library once it has settled on the cold disk: LeaveAfterDays after
  // its last play, or after it settled when nobody has played it, unless somebody keeps it. The API
  // decides what is due and the hand-off deletes it. An empty Keeps writes keeps.json in the state
  // directory.
  "Library": {
    "LeaveAfterDays": 7,
    "Keeps": ""
  },

  // What the API's planner decides the card should be doing, for the hand-off to carry out. A watched
  // rung is kept LeadSeconds ahead of its room's playhead, with BandSeconds either side so two units of
  // similar rank do not trade places on every plan; a unit runs MinRunSeconds before a less urgent one
  // may hold it, and is parked rather than held after ParkAfterSeconds or beyond MaxHeld stopped
  // processes. The two budgets are measured on the card: NvencBudget in 1080p-equivalents of
  // realtime, NvdecBudget in source decodes. PerRung false runs and holds a film's rungs and audio
  // together. The executor's report is trusted for StatusStaleSeconds.
  "Transcode": {
    "LeadSeconds": 120,
    "BandSeconds": 30,
    "MinRunSeconds": 60,
    "ParkAfterSeconds": 120,
    "MaxHeld": 3,
    "NvencBudget": 12,
    "NvdecBudget": 20,
    "PerRung": false,
    "StatusStaleSeconds": 30,
    "CatalogRefreshSeconds": 10
  },

  // Films people are waiting on, watched for by the API. An empty Path writes wishes.json in the
  // state directory systemd hands the service. A film counts as available once a release at or
  // above MinimumSource is offered; a camcorder recording does not.
  "Notify": {
    "Path": "",
    "SweepMinutes": 60,
    "MinimumSource": "Web"
  },

  // What the API keeps about each person, by the account the provider names them by: how they watch
  // (Preferences), what each account is called (Directory), and what they have watched and when each
  // film was last played (Watch). An empty value writes preferences.json, people.json and watch.json in
  // the state directory.
  "People": {
    "Preferences": "",
    "Directory": "",
    "Watch": ""
  },

  // Watch now: how many films may be watched while they are still arriving (MaxStreams). Each is a
  // download and a live transcode at once; past it, a person is offered Download instead.
  "Watch": {
    "MaxStreams": 4
  },

  // What the API tells people: each person's notifications (Inbox), the browsers they subscribed to
  // pushes (Devices), this server's push key pair (Keys, made once and never again: every
  // subscription is bound to it), and which kinds each person is pushed (Preferences). An empty
  // value writes notifications.json, push-devices.json, push-keys.json and
  // notification-preferences.json in the state directory.
  "Notifications": {
    "Inbox": "",
    "Devices": "",
    "Keys": "",
    "Preferences": ""
  },

  // Following a show. Path is the file holding who follows what and which episodes were announced
  // (an empty one is follows.json in the state directory). An episode is looked for from the day
  // after its air date until GiveUpDays past it, asked of the tracker at most once per AskMinutes,
  // and a followed show's description is asked of the film database again after RefreshHours.
  "Follow": {
    "Path": "",
    "RefreshHours": 24,
    "AskMinutes": 60,
    "GiveUpDays": 14
  },

  // Lists of films and shows to watch later, everybody's Watch later and the lists they named and
  // shared. Path is the file holding them (an empty one is lists.json in the state directory).
  "Lists": {
    "Path": ""
  },

  // The film database that describes a film: credits, certificate, genres, overview, artwork. The
  // API asks it, keeps what it said and the artwork under Directory (an empty one is films/ in the
  // state directory), serves its own copies, and asks again after RefreshDays. The token is a
  // credential and is set only in the environment as Tmdb__ReadAccessToken; without one, films are
  // described by the title index alone. Region picks whose certificate a film is shown with. The
  // films and shows trending this week, with their posters, are kept under PopularDirectory (an empty
  // one is popular/ in the state directory) and asked for again every few hours. A search result's
  // rating and overview are kept under GlancesDirectory (an empty one is glances/ in the state
  // directory): a year for a title out over a year, a week for anything newer. A person's credits
  // and a genre's most popular titles are kept under CatalogueDirectory (an empty one is catalogue/
  // in the state directory): a person's for a week, a genre's for a day.
  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p",
    "Language": "en-US",
    "Region": "US",
    "TimeoutSeconds": 15,
    "Directory": "",
    "ShowsDirectory": "",
    "PopularDirectory": "",
    "GlancesDirectory": "",
    "CatalogueDirectory": "",
    "RefreshDays": 14
  },

  // Listening in a voice channel. Off unless enabled: everyone in a channel the bot joins is heard.
  "Voice": {
    "Enabled": false,
    "Triggers": "okay computer, ok computer, okay computers, ok computers",
    "MaxCommandSeconds": 7
  },

  // The assistant: moviebot-assistant answers what people say to MovieBot, with the language model
  // below, and listens on Listen; the bot reaches it at BaseUrl. Enabled is whether the bot puts a
  // spoken request the room verbs do not cover to it; off unless enabled.
  "Assistant": {
    "Enabled": false,
    "Listen": "http://127.0.0.1:8191",
    "BaseUrl": "http://127.0.0.1:8191",
    "ConfirmWindowSeconds": 20,
    "OfferMinutes": 10,
    "LibraryInContext": 60,
    "IdleResetMinutes": 15
  },

  "Llm": {
    "Provider": "LlamaCpp",
    "Endpoint": "http://127.0.0.1:8190",
    "Model": "gemma-4-E2B-it-qat",
    "ContextWindow": 8192,
    "Temperature": 0,
    "TimeoutSeconds": 60
  },

  "LlmAgent": {
    "MaxIterations": 6
  },

  // Speech recognition for voice commands: the model the speech host loads, and the socket the bot
  // reaches it on.
  "Speech": {
    "ModelPath": "/opt/moviebot/whisper/models/ggml-small.en.bin",
    "SocketPath": "/run/moviebot-speech/speech.sock",
    "UseGpu": true,
    "NativeLibraryPath": "/opt/moviebot/whisper/lib/libwhisper.so",
    "Accelerators": [
      "vulkan"
    ],
    "AudioContextFrames": 400
  }
}
