// MovieBot settings, read by every MovieBot service.
//
// A copy of this file ships beside each program and holds the defaults. The copy a host edits is
// $XDG_CONFIG_HOME/moviebot/moviebot.settings.json of the account the services run as (by default
// ~/.config/moviebot/), or /etc/xdg/moviebot/moviebot.settings.json. The environment overrides any
// single key, as Section__Key, and it is where secrets go: tokens, keys and the tracker account.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  },

  // The Discord application. ApplicationId is the number on its General Information page, and
  // GuildIds the servers the bot answers in, each written as a string: ["123456789012345678"].
  "Discord": {
    "ApplicationId": null,
    "GuildIds": []
  },

  // The OpenID Connect provider people sign in with; MovieBot signs nobody in. Issuer is the
  // provider's issuer, exactly as its tokens carry it, and has no default: the API records it in its
  // database the first time it starts and refuses another until AdoptIssuer names it. Access tokens are taken for Audience alone and list a person's
  // Cinema actions in ActionsClaim. The site signs in as the public client SiteClientId, and on a
  // television as the public device client TvClientId; the API
  // exchanges the Activity's Discord token as ActivityClientId and the bot a Discord user as
  // BotClientId, each a confidential client whose secret is set only in the environment, as
  // Oidc__ActivityClientSecret and Oidc__BotClientSecret. SessionLifetime is the provider's refresh
  // lifetime: a session unseen here for longer has ended, and a phone's pairing with it is forgotten.
  "Oidc": {
    "Issuer": "",
    "Audience": "cinema",
    "ActionsClaim": "tks_actions",
    "SiteClientId": "cinema-site",
    "TvClientId": "cinema-tv",
    "ActivityClientId": "cinema-activity",
    "BotClientId": "cinema-bot",
    "AdoptIssuer": "",
    "SessionLifetime": "30.00:00:00"
  },

  // The television app built for this site (tv/), served at /tv.apk. App is its path; empty is
  // tv.apk in the state directory. Without the file, /tv.apk answers 404.
  "Tv": {
    "App": ""
  },

  // The phone app built for this site (phone/), served at /phone.apk. App is its path; empty is
  // phone.apk in the state directory. Without the file, /phone.apk answers 404.
  "Phone": {
    "App": ""
  },

  // Where people reach this host: the https address the Activity is mapped to.
  "Player": {
    "BaseUrl": ""
  },

  // How the bot and the hand-off reach the API, and where Discord's own servers reach it.
  "Api": {
    "BaseUrl": "http://127.0.0.1:8099",
    "PublicBaseUrl": ""
  },

  // The API's own address. nginx forwards to it; nothing else should.
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://127.0.0.1:8099" }
    }
  },

  // Everything the API keeps: people's records, the rooms, the subtitles it fetched and what the film
  // database said. Path is the SQLite file; empty is moviebot.db in the state directory systemd hands
  // the service.
  "Database": {
    "Path": ""
  },

  // The library the API serves. ColdRoot, when set, is a second disk finished films move to.
  "Media": {
    "Root": "/srv/moviebot/media",
    "ColdRoot": ""
  },

  "Subtitles": {
    "Root": "/var/lib/moviebot/subtitles"
  },

  // A room's guest link lasts GuestPassLifetime from when it is made; its guests are sent away once
  // nobody with an account has been in the room for GuestGrace, and it takes GuestsPerRoom at once.
  "Rooms": {
    "IdleTimeout": "00:30:00",
    "SweepInterval": "00:01:00",
    "GuestPassLifetime": "1.00:00:00",
    "GuestGrace": "00:02:00",
    "GuestsPerRoom": 10
  },

  // The hand-off writes films into MediaRoot, which must be the API's Media.Root, and ColdRoot,
  // which must be the API's Media.ColdRoot. TranscodeDisk is the one a transcode is written to
  // when it has the room, Media or Cold. Films share the GPU, so each of MaxConcurrentIngests runs
  // slower than one alone. DialogueBoost adds a dialogue-raised mix of each feature track after
  // the main pass, a CPU-bound pass that fills every core for as long as it runs.
  "Handoff": {
    "MediaRoot": "/srv/moviebot/media",
    "ColdRoot": "",
    "TranscodeDisk": "Media",
    "PollSeconds": 30,
    "MinimumFilmSizeMiB": 200,
    "StartAtProgress": 0.05,
    "MaxConcurrentIngests": 2,
    "DialogueBoost": false
  },

  // Where qBittorrent saves downloads, and how much of the disk they may take. ReservedGiB stays
  // free on that volume once a download lands, for the transcode of the film it admits, which
  // holds no claim of its own until its ingest starts; 0 when nothing else writes there. The
  // claims of transcodes already running are subtracted on top of it, as measured.
  "Download": {
    "Root": "/srv/moviebot/downloads",
    "MaximumGiB": 300,
    "WarningGiB": 250,
    "ReservedGiB": 30
  },

  "QBittorrent": {
    "BaseUrl": "http://127.0.0.1:8080",
    "Category": "moviebot",
    "SequentialDownload": true,
    "FirstLastPiecePriority": true
  },

  // Which releases are offered. The tracker's category names are set in the environment, beside
  // the tracker account, as Selection__AllowedCategories__0, __1 and so on.
  "Selection": {
    "MaximumResolution": "Hd1080",
    "PreferredResolution": "Hd1080",
    "MaximumSizeGiB": 25,
    "MaximumResults": 10,
    "TierByTrackerFlags": true
  },

  // When a downloaded film's torrent and downloaded files are removed: once it has seeded the
  // tracker's minimum plus MarginHours, or reached the tracker's ratio plus RatioMargin after
  // RatioMinimumHours of seeding, whichever comes first.
  "Retention": {
    "TrackerMinimumHours": 48,
    "MarginHours": 12,
    "TrackerRatio": 1,
    "RatioMargin": 0.1,
    "RatioMinimumHours": 3
  },

  // How long a film stays in the library once it has settled on the cold disk: LeaveAfterDays after
  // its last play, or after it settled when nobody has played it. The API decides what is due and the
  // hand-off deletes it.
  "Library": {
    "LeaveAfterDays": 7
  },

  // What the API's planner decides the card should be doing, for the hand-off to carry out. A watched
  // rung is kept LeadSeconds ahead of its room's playhead, with BandSeconds either side so two units of
  // similar rank do not trade places on every plan; a unit runs MinRunSeconds before a less urgent one
  // may hold it, and is parked rather than held after ParkAfterSeconds or beyond MaxHeld stopped
  // processes. The two budgets are measured on the card: NvencBudget in 1080p-equivalents of
  // realtime, NvdecBudget in source decodes. PerRung false runs and holds a film's rungs and audio
  // together. The executor's report is trusted for StatusStaleSeconds.
  "Transcode": {
    "LeadSeconds": 120,
    "BandSeconds": 30,
    "MinRunSeconds": 60,
    "ParkAfterSeconds": 120,
    "MaxHeld": 3,
    "NvencBudget": 12,
    "NvdecBudget": 20,
    "PerRung": false,
    "StatusStaleSeconds": 30,
    "CatalogRefreshSeconds": 10
  },

  // Films people are waiting on, watched for by the API every SweepMinutes. A film counts as
  // available once a release at or above MinimumSource is offered; a camcorder recording does not.
  "Notify": {
    "SweepMinutes": 60,
    "MinimumSource": "Web"
  },

  // Watch now: how many films may be watched while they are still arriving (MaxStreams). Each is a
  // download and a live transcode at once; past it, a person is offered Download instead.
  "Watch": {
    "MaxStreams": 4
  },

  // Wants. Every PassSeconds the prefetcher starts at most one download for what people want to watch,
  // while no room plays and the disk has room, with at most Concurrent of its downloads arriving.
  // Prefetch false leaves wants unfetched, and the prefetcher fetches only the titles of fixed plans. A
  // title nothing is offered for is asked of the tracker again after AskMinutes. A title somebody
  // wants and has not watched stays in the library for HoldDays from the want.
  "Wants": {
    "Prefetch": true,
    "PassSeconds": 60,
    "Concurrent": 1,
    "HoldDays": 90,
    "AskMinutes": 60
  },

  // Plans. The room is made OpenMinutes before the time the maker picked, closed, with the people
  // coming let in, and everybody coming is reminded RemindMinutes before it. The keeper looks every
  // PassSeconds.
  "Plans": {
    "RemindMinutes": 15,
    "OpenMinutes": 30,
    "PassSeconds": 15
  },

  // Following a show. An episode is looked for from the day after its air date until GiveUpDays past
  // it, asked of the tracker at most once per AskMinutes, and a followed show's description is asked
  // of the film database again after RefreshHours.
  "Follow": {
    "RefreshHours": 24,
    "AskMinutes": 60,
    "GiveUpDays": 14
  },

  // Save offline: films copied onto a person's device. A save still being made keeps its title in the
  // library and in place for HoldHours after it was made, and its grant opens its tracks to the
  // device's own downloader for as long. A person fetches at most
  // MaxTransfersPerPerson tracks at once and the server sends at most MaxTransfers; while a room has
  // somebody in it, each transfer is held to MegabitsPerTransferWhileWatched (0 for no limit). A
  // title asked for before the library holds it is fetched onto the server and waited on for
  // WantDays, after which the device stops waiting for it.
  "Offline": {
    "HoldHours": 48,
    "MaxTransfersPerPerson": 6,
    "MaxTransfers": 12,
    "MegabitsPerTransferWhileWatched": 20,
    "WantDays": 14
  },

  // The film database that describes a film: credits, certificate, genres, overview, artwork. The
  // API asks it, keeps what it said in its database and the artwork under the directories here,
  // serves its own copies, and asks again after RefreshDays (RecentRefreshDays for a film released within the last sixty days, whose rating moves daily). The token is a credential and is set only
  // in the environment as Tmdb__ReadAccessToken; without one, films are described by the title index
  // alone. Region picks whose certificate a film is shown with. A film's artwork is kept under
  // Directory and a show's under ShowsDirectory; the posters of what is trending this week, asked for
  // again every few hours, under PopularDirectory; a search result's poster under GlancesDirectory,
  // its rating and overview kept a year for a title out over a year and a week for anything newer;
  // and a person's portrait under CatalogueDirectory, their credits kept a week and a genre's most
  // popular titles a day. An empty directory is films/, shows/, popular/, glances/ or catalogue/ in
  // the state directory. Every ShelvesWarmMinutes the Discover shelves the same for everybody are
  // asked for again, which asks the database only for what has come due; 0 asks nothing ahead.
  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3",
    "ImageBaseUrl": "https://image.tmdb.org/t/p",
    "Language": "en-US",
    "Region": "US",
    "TimeoutSeconds": 15,
    "Directory": "",
    "ShowsDirectory": "",
    "PopularDirectory": "",
    "GlancesDirectory": "",
    "CatalogueDirectory": "",
    "RefreshDays": 14,
    "RecentRefreshDays": 1,
    "ShelvesWarmMinutes": 60
  },

  // IMDb's non-commercial datasets (datasets.imdbws.com), personal use only. The API imports the films
  // and shows of title.basics and title.ratings into its database every RefreshHours, asking after the
  // two files with HEAD and reading them only when they have changed, and keeps those with at least
  // MinVotes votes. They rank the questions asked by rating and give each title its IMDb rating. Without
  // the import, nothing is ranked by IMDb. Enabled false turns the import off.
  "Imdb": {
    "Enabled": true,
    "BaseUrl": "https://datasets.imdbws.com/",
    "RefreshHours": 24,
    "MinVotes": 100
  },

  // Listening in a voice channel. Off unless enabled: everyone in a channel the bot joins is heard.
  "Voice": {
    "Enabled": false,
    "Triggers": "okay computer, ok computer, okay computers, ok computers",
    "MaxCommandSeconds": 7
  },

  // The assistant: moviebot-assistant is the plugin that helps people find films, and it listens on
  // Listen. The assistant harness runs the model and holds the conversations; HarnessAddress is where
  // the plugin reaches it, and its key there, PluginKey, is set only in the environment as
  // Assistant__PluginKey. RecordApiTo, when set, is a file the plugin appends every answer it gets from
  // the API to, for a test to replay.
  "Assistant": {
    "Listen": "http://127.0.0.1:8191",
    "HarnessAddress": "http://127.0.0.1:8082",
    "PluginKey": "",
    "RecordApiTo": ""
  },

  // Speech recognition for voice commands: the unix socket of the speech daemon the bot hears
  // through. Empty means there is none, and nothing is heard.
  "Speech": {
    "SocketPath": ""
  }
}
