<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.MovieBot.Catalogue</RootNamespace>
    <AssemblyName>moviebot-catalogue</AssemblyName>
    <Version>0.2.0</Version>

    <!-- Compiled ahead of time, like the API and the hand-off: a process that runs for months keeps
         its code and type data in the binary rather than in memory the JIT wrote. Every comparison
         is ordinal or invariant, so the globalization data is not loaded. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared settings file, shipped beside the binary as the defaults. -->
    <Content Include="../moviebot.settings.json" Link="moviebot.settings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <!-- The catalogue, in one SQLite file. Raw ADO, which is AOT-safe; the bundle carries the native
         e_sqlite3, FTS5 with it. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <!-- GHSA-2m69-gcr7-jv3q is an advisory on the native SQLite the bundle carries, with no patched
       bundle to move to. The database runs no SQL that is not this service's own. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-2m69-gcr7-jv3q" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the settings files every MovieBot program reads, the film database's options (its token
         is in the environment) and the connection pool every long-lived client keeps. -->
    <ProjectReference Include="../../../moviebot-acquire/src/MovieBot.Acquire/MovieBot.Acquire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MovieBot.Tests" />
  </ItemGroup>

</Project>
