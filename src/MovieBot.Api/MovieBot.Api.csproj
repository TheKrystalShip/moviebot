<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.MovieBot.Api</RootNamespace>
    <AssemblyName>moviebot-api</AssemblyName>
    <Version>1.10.0</Version>

    <!-- Compiled ahead of time. What a long-running .NET process holds is not its heap but the
         code the JIT has written and the type data the runtime built around it, and this
         process has neither: its code and its type system are data in the binary, paged in from
         the file. Every comparison here is ordinal, so the globalization data is not loaded.
         The heap belongs to a handful of rooms and is collected on one thread: a heap per core
         is for a server saturating them, and the film itself never touches the heap. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MovieBot.Core/MovieBot.Core.csproj" />
    <ProjectReference Include="../../../moviebot-acquire/src/MovieBot.Acquire/MovieBot.Acquire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MovieBot.Tests" />
  </ItemGroup>

</Project>
