<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.MovieBot.Handoff</RootNamespace>
    <AssemblyName>moviebot-handoff</AssemblyName>
    <Version>0.10.0</Version>

    <!-- Compiled ahead of time. What a long-running .NET process holds is not its heap but the
         code the JIT has written and the type data the runtime built around it, and this
         process has neither: its code and its type system are data in the binary, paged in from
         the file. Every string comparison in the pipeline is ordinal or invariant, so the
         globalization data is not loaded either. -->
    <PublishAot>true</PublishAot>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- The ingest is referenced for its pipeline, not run as a program, so the SDK's check that
         an executable reference is built the same way as the one referencing it has nothing to
         protect here. -->
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The only place these two meet. The transcoder knows nothing about torrents and the
         acquiring library knows nothing about ffmpeg; this carries a finished download from one
         to the other. -->
    <ProjectReference Include="../MovieBot.Ingest/MovieBot.Ingest.csproj" />
    <ProjectReference Include="../../../moviebot-acquire/src/MovieBot.Acquire/MovieBot.Acquire.csproj" />
  </ItemGroup>

</Project>
