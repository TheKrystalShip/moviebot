<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>TheKrystalShip.MovieBot.Assistant</RootNamespace>
    <AssemblyName>moviebot-assistant</AssemblyName>
    <Version>3.5.1</Version>

    <!-- The plugin package and the film database's answers are read with reflection-based JSON, so
         this runs on the JIT. A service that runs for weeks gains nothing from tiering, so a method
         is compiled once at full optimisation. -->
    <TieredCompilation>false</TieredCompilation>
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared settings file, shipped beside the binary as the defaults. -->
    <Content Include="../moviebot.settings.json" Link="moviebot.settings.json" CopyToOutputDirectory="PreserveNewest" />

  </ItemGroup>

  <ItemGroup>
    <!-- The plugin to the assistant harness: the harness client, profile registration, the tool host
         and the routes this service relays to the people of Krystal Cinema. -->
    <PackageReference Include="TheKrystalShip.Agent.Plugin" Version="1.0.0-dev.17" />

    <!-- Checks the identity provider's access tokens, as the API does. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- For the settings file's lookup. -->
    <ProjectReference Include="../../../moviebot-acquire/src/MovieBot.Acquire/MovieBot.Acquire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MovieBot.Tests" />
  </ItemGroup>

</Project>
